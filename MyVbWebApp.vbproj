<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>MyVbWebApp</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>

    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
    
    <!-- Disable Scoped CSS to prevent BLAZOR102 errors -->
    <ScopedCssEnabled>false</ScopedCssEnabled>
  </PropertyGroup>

  <!-- Global imports so VB.NET recognizes ASP.NET Core extension methods -->
  <ItemGroup>
    <Import Include="Microsoft.AspNetCore.Builder" />
    <Import Include="Microsoft.AspNetCore.Hosting" />
    <Import Include="Microsoft.Extensions.DependencyInjection" />
    <Import Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.12" />
  </ItemGroup>
</Project>